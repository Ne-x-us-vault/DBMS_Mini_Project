rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Expense documents must carry a positive paise amount.
    function validExpense() {
      return request.resource.data.amountPaise is int
        && request.resource.data.amountPaise > 0;
    }

    // Message documents must carry a non-empty text string.
    function validMessage() {
      return request.resource.data.text is string
        && request.resource.data.text.size() > 0;
    }

    match /groups/{groupId} {
      allow read, write: if signedIn();

      match /expenses/{expenseId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && validExpense();
        allow delete: if signedIn();
      }

      match /activity/{activityId} {
        allow read, write: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && validMessage();
        allow delete: if signedIn();
      }
    }

    // Each account only reads/writes its own membership doc and list.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /groups/{groupId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}